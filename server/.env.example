# Copy this file to .env and adjust as needed.
# Local Postgres started via `docker compose up -d` (see docker-compose.yml)
DATABASE_URL="postgresql://aux:aux@localhost:5432/aux?schema=public"
PORT=3000

# Signs login tokens. Required: the server won't start without it.
# Generate your own with: openssl rand -hex 32
JWT_SECRET=""

# MusicBrainz requires every app to identify itself: "AppName/version ( contact )".
# Put your own email or the repo URL as the contact. Generic agents get blocked.
MUSICBRAINZ_USER_AGENT="AUX-CPSC491/0.1.0 ( https://github.com/armaanq/AUX_CPSC491 )"
# Optional: point at a self-hosted mirror instead of musicbrainz.org (no rate limit there).
# MUSICBRAINZ_BASE_URL="http://localhost:5000/ws/2"
